# Copy this file to .env and fill in your own values.
# DEVNET ONLY — do not put a real/mainnet secret key in this file, ever.

# --- Server ---
# Solana wallet address that RECEIVES payments (yours). Run
# `npm run generate-wallet` if you don't have one.
PAY_TO_ADDRESS=YourSolanaWalletAddressHere

# x402 facilitator to use. The public testnet facilitator is fine for dev.
FACILITATOR_URL=https://x402.org/facilitator

PORT=4022

# --- Client ---
# Base58-encoded secret key of a Solana devnet TESTNET wallet, used to pay
# for requests. This is the same format `solana-keygen` / Phantom export —
# NOT a JSON byte array.
CLIENT_PRIVATE_KEY=YourBase58PrivateKeyHere

SERVER_URL=http://localhost:4022
