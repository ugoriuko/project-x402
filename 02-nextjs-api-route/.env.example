# Copy this file to .env and fill in your own values.
# TESTNET ONLY — do not put a real/mainnet private key in this file, ever.
#
# Next.js loads this file automatically (no dotenv needed for the server
# routes) — only the standalone client.js script uses dotenv explicitly.

# --- Server ---
# Wallet address that RECEIVES payments (yours). Run `npm run generate-wallet`
# if you don't have one.
PAY_TO_ADDRESS=0xYourWalletAddressHere

# x402 facilitator to use. The public testnet facilitator is fine for dev.
FACILITATOR_URL=https://x402.org/facilitator

# --- Client ---
# Private key of a Base Sepolia TESTNET wallet used to pay for requests.
CLIENT_PRIVATE_KEY=0xYourTestnetPrivateKeyHere

SERVER_URL=http://localhost:3000
